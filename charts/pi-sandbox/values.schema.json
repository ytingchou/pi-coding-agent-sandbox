{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sandbox": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxSessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 55535
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "cleanupIntervalSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "ephemeralIdleTtlSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "piIdleDisconnectSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mongodb": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "uriKey": {
          "type": "string",
          "minLength": 1
        },
        "usernameKey": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "authSource": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMS": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
