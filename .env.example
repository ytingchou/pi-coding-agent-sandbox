# Complete defaults, optional/required rules and deployment examples:
# docs/configuration.md (README also has a quick reference).
# Empty values use the fallback described below; never commit real secrets.

# Outer Agents SDK (API container). URL, key and model are independent of Pi.
# Required for /run; optional for no-model tests. No default key.
OPENAI_API_KEY=
# Optional; internal gateways should set their actual tool-capable model ID.
OPENAI_MODEL=gpt-4.1-mini
# Optional for public OpenAI (default https://api.openai.com/v1).
# Required for internal-only deployment; include API prefix, usually /v1.
OPENAI_BASE_URL=
# Optional: chat_completions when base URL is set, otherwise responses.
# Internal gateways: explicitly choose chat_completions or responses.
OPENAI_API_MODE=

# Pi model (sandbox workers); can use a DIFFERENT gateway/key/model than the outer Agent.
# URL/model/mode do NOT inherit OPENAI_*. Only the optional key fallback is shared.
PI_MODEL=gpt-4.1-mini
# Optional for public OpenAI; internal-only deployment must set this too.
PI_BASE_URL=
# Optional: empty uses OPENAI_API_KEY. Prefer a separate gateway key in production.
PI_API_KEY=
# Optional: chat_completions with PI_BASE_URL; both empty use built-in OpenAI.
PI_API_MODE=
# Optional, CUSTOM provider only (PI_BASE_URL or PI_API_MODE is set).
# Replace 128000 with the actual model/gateway context limit.
PI_CONTEXT_WINDOW=128000
# Optional, CUSTOM provider only. Per model response, not total run budget.
# Start at 4096; require 0 < PI_MAX_TOKENS <= PI_CONTEXT_WINDOW.
PI_MAX_TOKENS=4096
# Optional JSON object, CUSTOM provider only. Leave empty unless needed.
# Example {"supportsUsageInStreaming":false} may make token usage unavailable.
PI_MODEL_COMPAT=

# Control-plane authentication: defaults are for a local demo only.
# Both are optional in code, but MUST be replaced for company/shared deployment.
# Generate twice: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Client -> API. This is NOT the model API key.
API_TOKEN=local-demo-change-me
# API -> workers. Use a DIFFERENT value; keep it equal across API and all workers.
SANDBOX_TOKEN=worker-demo-change-me

# Optional: host localhost port only; container API port remains 8000.
API_PORT=8000
# Optional: seconds per Pi prompt, not the complete outer Agent run.
# Start with 180; increase only for measured gateway/workload latency.
PROMPT_TIMEOUT=180
# Optional: per-worker session count, including idle/allocating sessions.
# Sample default 8; start at 2 for initial company deployment and measure memory.
MAX_SESSIONS=8
